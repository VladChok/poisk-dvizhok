{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VladChok/poisk-dvizhok/schema/map.schema.json",
  "title": "Research Map — v0",
  "description": "map.json, one per brief. Contract: docs/CONTRACT-research-map-evidence-v0.md. Node key order is fixed as in properties (save -> reopen byte-for-byte). Cross-node rules (parents resolve, one FIELD root, reason outside OPEN, sources/reach from CANDIDATE, DONE only with children, DEEP_DIVE node not DONE, unique id) are checked by tools/research-map.mjs validate.",
  "type": "object",
  "properties": {
    "brief": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
  },
  "required": ["brief", "nodes"],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "level": { "enum": ["FIELD", "CLUSTER", "CANDIDATE", "DEEP_DIVE"] },
        "title": { "type": "string", "minLength": 1 },
        "parent": { "type": ["string", "null"] },
        "status": { "enum": ["OPEN", "CUT", "SURVIVED", "WATCH", "DEEP_DIVE", "DONE"] },
        "reason": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "$ref": "evidence.schema.json#/$defs/pointer" } },
        "reach": { "type": "array", "items": { "$ref": "#/$defs/reach" } },
        "notes": { "type": "string" }
      },
      "required": ["id", "level", "title", "parent", "status", "reason", "sources", "reach", "notes"],
      "additionalProperties": false
    },
    "reach": {
      "description": "Actual access log; order = chronology, reach[0] = discovery (rule A). tool vocabulary is open.",
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
      },
      "required": ["tool", "at"],
      "additionalProperties": false
    }
  }
}
